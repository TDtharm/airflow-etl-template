# ============================================================
# ETL Template – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# -- Postgres --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# -- MSSQL --
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=master
MSSQL_USER=sa
MSSQL_PASSWORD=

# -- Qdrant --
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# -- Impala --
IMPALA_HOST=localhost
IMPALA_PORT=21050
IMPALA_DB=default
IMPALA_USER=
IMPALA_PASSWORD=
IMPALA_AUTH_MECHANISM=PLAIN          # PLAIN, LDAP, GSSAPI (Kerberos)
IMPALA_USE_SSL=false
IMPALA_KERBEROS_SERVICE_NAME=impala  # ใช้เมื่อ auth=GSSAPI
IMPALA_CA_CERT=                      # path to CA cert for SSL

# -- HDFS (WebHDFS) --
HDFS_URL=http://localhost:9870
HDFS_USER=hdfs
HDFS_AUTH_MECHANISM=PLAIN            # PLAIN, LDAP, GSSAPI (Kerberos)
HDFS_PASSWORD=                       # ใช้เมื่อ auth=LDAP
HDFS_KERBEROS_PRINCIPAL=             # e.g. user@REALM.COM (ต้อง kinit ก่อน)
HDFS_ROOT=/

# -- MinIO --
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# -- NATS --
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=

# -- Notification (Google Chat) --
GCHAT_WEBHOOK_URL=                   # https://chat.googleapis.com/v1/spaces/XXX/messages?key=YYY&token=ZZZ

# -- Airflow --
ETL_PROJECT_DIR=/opt/airflow/dags/etl-template
