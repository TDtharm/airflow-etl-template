# ============================================================
# ETL Template – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# -- Postgres --
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# -- MSSQL --
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=master
MSSQL_USER=sa
MSSQL_PASSWORD=

# -- Qdrant --
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# -- Impala --
IMPALA_HOST=localhost
IMPALA_PORT=21050
IMPALA_DB=default
IMPALA_USER=
IMPALA_PASSWORD=

# -- MinIO --
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# -- NATS --
NATS_SERVERS=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=
